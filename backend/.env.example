PORT=5000
APP_ENV=development
# Hosted examples: config/staging.env.example and config/production.env.example
# MONGO_DB_NAME=nabad_development

MONGO_URI=mongodb://127.0.0.1:27017/nabad

JWT_SECRET=

# Session timeouts (see src/sessionConfig.js). Use short values like 2m / 1m for a live demo.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_WARNING_BEFORE=2m
# Turn email 2FA on for new email/password accounts. Keep false until signup verifies the email.
TWO_FACTOR_ON_SIGNUP=false
# Check new passwords against Have I Been Pwned (only 5 characters of a hash are sent). On unless "off";
# off in tests unless "on". If the service is down, passwords are allowed and the failure is logged.
PWNED_PASSWORDS_CHECK=on

CLIENT_ORIGIN=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Nabad <no-reply@nabad.app>"

# Google OAuth (create a Web application OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
