PORT=5000

# Local MongoDB, or a MongoDB Atlas cluster URI
MONGO_URI=mongodb://127.0.0.1:27017/nabad

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=15m

# Frontend origin allowed to call this API (for CORS + cookies)
CLIENT_ORIGIN=http://localhost:3000

# Password-reset email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Nabad <no-reply@nabad.app>"

# Required for encrypted TOTP secrets. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
