NODE_ENV=production
APP_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=nabad_production
JWT_SECRET=
# Key for the HMAC of emailed sign-in codes: at least 32 random characters, not the JWT_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_CODE_SECRET=
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_WARNING_BEFORE=2m
# Turn email 2FA on for new email/password accounts. Keep false until signup verifies the email.
TWO_FACTOR_ON_SIGNUP=false
# Check new passwords against Have I Been Pwned (only 5 characters of a hash are sent). On unless "off";
# off in tests unless "on". If the service is down, passwords are allowed and the failure is logged.
PWNED_PASSWORDS_CHECK=on
CLIENT_ORIGIN=https://example.com
# Proxies in front of the app: 2 for the frontend /api rewrite plus the host load balancer.
TRUST_PROXY=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback
# AI triage and report review use your protected, self-hosted Ollama gateway.
LLM_PROVIDER=ollama
LLM_API_URL=https://ai.example.com
LLM_API_KEY=replace-with-self-hosted-gateway-token
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_MS=60000
# Photos must show written reports.
LLM_VISION_ENABLED=true
# Error tracking with Sentry: the project's DSN, or empty to send nothing. Reports carry only the error type, stack
# trace, route, status, requestId and environment, never health or personal data (docs/architecture.md).
SENTRY_DSN=
