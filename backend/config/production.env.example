NODE_ENV=production
APP_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=nabad_production
JWT_SECRET=
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_WARNING_BEFORE=2m
# Turn email 2FA on for new email/password accounts. Keep false until signup verifies the email.
TWO_FACTOR_ON_SIGNUP=false
# Check new passwords against Have I Been Pwned (only 5 characters of a hash are sent). On unless "off";
# off in tests unless "on". If the service is down, passwords are allowed and the failure is logged.
PWNED_PASSWORDS_CHECK=on
CLIENT_ORIGIN=https://example.com
# Proxies in front of the app: 2 for the frontend /api rewrite plus the host load balancer.
TRUST_PROXY=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback
