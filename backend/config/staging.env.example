NODE_ENV=production
APP_ENV=staging
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=nabad_staging
JWT_SECRET=
# Key for the HMAC of emailed sign-in codes: at least 32 random characters, not the JWT_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_CODE_SECRET=
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_WARNING_BEFORE=2m
# Turn email 2FA on for new email/password accounts. Keep false until signup verifies the email.
TWO_FACTOR_ON_SIGNUP=false
# Check new passwords against Have I Been Pwned (only 5 characters of a hash are sent). On unless "off";
# off in tests unless "on". If the service is down, passwords are allowed and the failure is logged.
PWNED_PASSWORDS_CHECK=on
CLIENT_ORIGIN=https://staging.example.com
# Proxies in front of the app: 2 for the frontend /api rewrite plus the host load balancer.
TRUST_PROXY=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.example.com/api/auth/google/callback
# Gemini's OpenAI-compatible endpoint. Supply LLM_API_KEY through the deployment secret manager.
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=30000
LLM_VISION_ENABLED=true
