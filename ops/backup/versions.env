# Exact tool versions for the backup workflows. Each was released at least two weeks before it was
# pinned, and every download is checked against the SHA-256 below before it is used.
# MongoDB Database Tools 100.19.0 (2026-09-21) supports MongoDB 8.0; the checksum was taken from
# fastdl.mongodb.org and downloads.mongodb.org, which serve identical files.
MONGODB_TOOLS_VERSION=100.19.0
MONGODB_TOOLS_SHA256=46d9dcba4ff2049c0ac6139f77783d14b1492d8910534ea6e95de50688afe72e
# mongosh 2.13.0 (2026-10-05); checksum from MongoDB's official mongosh.json release feed.
MONGOSH_VERSION=2.13.0
MONGOSH_SHA256=b2089e67641a28aa621476c4d62c69f66b9a41484baba24d8a8b1f5f96e92d0b
# age v1.3.2 (2026-08-29), the official release from github.com/FiloSottile/age.
AGE_VERSION=v1.3.2
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
# The throwaway MongoDB for the restore check: same 7.0 line as docker-compose.yml. GitHub's runners
# can't run 8.0, which Atlas uses. Must match the service image in .github/workflows/db-backup.yml.
RESTORE_MONGO_IMAGE=mongo:7.0.43@sha256:1f995ad6fdb93244a1addab1b58f934a0bc2f5643c38e02f5e9d7f0c7d227a7b
