# Local Docker settings for the backend (docker-compose.yml reads this file as is).
# Every value here is a LOCAL PLACEHOLDER: safe to commit, useless anywhere else. Never put real secrets here.
# To change something, copy this file to .env.docker (git-ignored) and edit only the lines you need there.
# Service addresses (MongoDB, Mailpit, CLIENT_ORIGIN) are set in docker-compose.yml.

# At least 32 characters each. Local only: a hosted environment needs its own random values.
JWT_SECRET=local-docker-only-jwt-secret-not-for-production
TWO_FACTOR_CODE_SECRET=local-docker-only-2fa-code-key-not-for-production

# Mailpit accepts any login, so these are placeholders too.
SMTP_USER=nabad-local
SMTP_PASS=nabad-local
EMAIL_FROM="Nabad (local) <no-reply@nabad.local>"

# New email/password accounts get email 2FA, so the sign-in code flow can be tested through the Mailpit inbox.
TWO_FACTOR_ON_SIGNUP=true

SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_WARNING_BEFORE=2m

# Checks new passwords against Have I Been Pwned (only 5 characters of a hash leave your machine).
# Set to "off" to work fully offline; if the service can't be reached, passwords are allowed.
PWNED_PASSWORDS_CHECK=on

# Google sign-in stays off locally unless you add your own OAuth client in .env.docker (both or neither), with
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback listed on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Clinician/product-approved triage rules. Empty until approved rules are supplied.
TRIAGE_RULES_JSON=[]

# The Compose Ollama service runs this model locally; no hosted AI API key is used.
LLM_PROVIDER=ollama
LLM_API_URL=http://ollama:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_MS=60000
# Photos must show written reports.
LLM_VISION_ENABLED=true
LLM_ALLOW_INSECURE_HTTP=true
